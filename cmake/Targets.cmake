if(SEIS3D_ENABLE_CUDA)
    # Separate CUDA library keeps /W4, OpenMP and CXX flags out of nvcc.
    enable_language(CUDA)
    find_package(CUDAToolkit REQUIRED)
    add_library(seis3d_cuda STATIC "${SEIS3D_SOURCE_ROOT}/src/three_d/CudaEngine3D.cu")
    target_include_directories(seis3d_cuda PRIVATE "${SEIS3D_SOURCE_ROOT}/include" "${SEIS3D_SOURCE_ROOT}/src")
    set(CMAKE_CUDA_RUNTIME_LIBRARY Shared)
    set_target_properties(seis3d_cuda PROPERTIES CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON CUDA_RUNTIME_LIBRARY Shared)
    target_compile_options(seis3d_cuda PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:--fmad=false>)
    target_link_libraries(seis3d_cuda PUBLIC CUDA::cudart)
    if(WIN32)
        find_file(SEIS3D_CUDART_DLL NAMES cudart64_12.dll cudart64_13.dll PATHS "${CUDAToolkit_BIN_DIR}" NO_DEFAULT_PATH REQUIRED)
    endif()
    add_library(seis_compute_cuda STATIC "${SEIS3D_SOURCE_ROOT}/src/common/CudaDevices.cu")
    target_include_directories(seis_compute_cuda PRIVATE "${SEIS3D_SOURCE_ROOT}/include")
    set_target_properties(seis_compute_cuda PROPERTIES CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON CUDA_RUNTIME_LIBRARY Shared)
    target_link_libraries(seis_compute_cuda PUBLIC CUDA::cudart)
    target_compile_definitions(seis_compute PUBLIC SEIS3D_HAS_CUDA=1)
    target_link_libraries(seis_compute PRIVATE seis_compute_cuda)
    target_link_libraries(seis3d_curvilinear_core PRIVATE seis3d_cuda)
endif()
function(seis3d_deploy_cuda target)
    if(SEIS3D_ENABLE_CUDA AND WIN32)
        add_custom_command(TARGET ${target} POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${SEIS3D_CUDART_DLL}" "$<TARGET_FILE_DIR:${target}>" VERBATIM)
    endif()
endfunction()
if(SEIS3D_ENABLE_OPENMP)
    find_package(OpenMP QUIET COMPONENTS CXX)
    if(OpenMP_CXX_FOUND)
        target_link_libraries(seis3d_curvilinear_core PUBLIC OpenMP::OpenMP_CXX)
        target_compile_definitions(seis3d_curvilinear_core PUBLIC SEIS3D_HAS_OPENMP=1)
        message(STATUS "Seis3D CPU OpenMP enabled; runtime workers can be set to 1 for the serial reference.")
    else()
        message(STATUS "OpenMP unavailable; building the serial CPU reference.")
    endif()
endif()
