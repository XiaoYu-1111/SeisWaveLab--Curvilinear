# Shared targets for the standalone repository and optional outer wrapper.
set(SEIS3D_SOURCE_ROOT "${SEIS3D_REPOSITORY_ROOT}")
# Keep headers and implementation files visible under the inner project in VS.
file(GLOB_RECURSE seis3dPublicHeaders CONFIGURE_DEPENDS "${SEIS3D_SOURCE_ROOT}/include/Seis3D/*.hpp")
file(GLOB_RECURSE seis2dPublicHeaders CONFIGURE_DEPENDS "${SEIS3D_SOURCE_ROOT}/include/Seis2D/*.hpp")
file(GLOB_RECURSE seisCommonHeaders CONFIGURE_DEPENDS "${SEIS3D_SOURCE_ROOT}/include/SeisCommon/*.hpp")
file(GLOB_RECURSE seis3dProjectSources CONFIGURE_DEPENDS
    "${SEIS3D_SOURCE_ROOT}/src/*.cpp" "${SEIS3D_SOURCE_ROOT}/src/*.cu"
    "${SEIS3D_SOURCE_ROOT}/src/*.hpp" "${SEIS3D_SOURCE_ROOT}/src/*.cuh" "${SEIS3D_SOURCE_ROOT}/src/*.inc")
source_group(TREE "${SEIS3D_SOURCE_ROOT}" FILES ${seis3dPublicHeaders} ${seis2dPublicHeaders} ${seisCommonHeaders} ${seis3dProjectSources})

function(seis3d_target_options target)
    target_compile_definitions(${target} PRIVATE SEIS3D_OUTPUT_ROOT="${SEIS3D_OUTPUT_ROOT}")
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /permissive- /utf-8)
        target_compile_definitions(${target} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
    endif()
endfunction()
