include_guard(GLOBAL)
set(SEISWAVE_VERSION_FILE "${CMAKE_CURRENT_LIST_DIR}/../VERSION")
file(READ "${SEISWAVE_VERSION_FILE}" SEISWAVE_VERSION)
string(STRIP "${SEISWAVE_VERSION}" SEISWAVE_VERSION)
if(NOT SEISWAVE_VERSION MATCHES "^[0-9]+\.[0-9]+\.[0-9]+$")
    message(FATAL_ERROR "VERSION must contain one major.minor.patch version")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${SEISWAVE_VERSION_FILE}")
